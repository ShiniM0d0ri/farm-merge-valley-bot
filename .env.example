# ---------------------------------------------------------------------------
# Copy to `.env` and fill in. `.env` is git-ignored and must never be committed.
# Every value below is a secret or machine-specific path.
# ---------------------------------------------------------------------------

# Nakama server key. Game-wide constant (not personal) - the game client ships it, and it is in any
# HAR of the activity: look for `Authorization: Basic <base64>` on any /v2/rpc/... request and
# base64-decode it (the decoded value is "<key>:"). Also recoverable from the client bundle's string
# table. README "Secrets" has the one-liner.
FMV_KEY=

# Your own Discord user id. This is what identifies the account the bot drives - the personal one.
# In Discord: Settings > Advanced > Developer Mode, then right-click your avatar > Copy User ID.
# (It is also the `usn`/`uid` owner of the captured session.)
FMV_DISCORD_ID=

# The Activity's Discord application id. Game-wide: it is the subdomain of the activity host
# (`https://<APP_ID>.discordsays.com/...`) and the `client_id` in the activity URL, so any HAR shows it.
FMV_APP_ID=

# Directory holding the extracted game config (`*_jsonpack.json`).
# Relative paths are resolved from the repo root. See README "Game config".
FMV_CFG=./config

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Where the captured Nakama session lives. Defaults to ./session.json.
# The session token is a secret: it is your account, so the file is git-ignored.
# FMV_SESSION=./session.json

# Set to 1 to let the bot renew the session by itself when the token expires.
# WARNING: renewal supersedes the session your game client holds and shows it
# "Disconnected - Connection lost". Prefer re-capturing a token instead (README "Secrets").
# FMV_ALLOW_REFRESH=1

# HAR capture used by the recon probes in scratch/ (they default to ./capture_launch.har and
# ./capture_levelup.har, both git-ignored). Point this at your export instead of copying it.
# FMV_HAR=./capture_launch.har
